#!/bin/sh
set -e

case "$1" in
    remove|purge)
        # The rule is created at runtime by "Enable Passwordless Mode". Do not
        # leave a stale authorization behind after the package is removed.
        rm -f /etc/polkit-1/rules.d/50-devnet.rules
        rmdir /usr/libexec/devnet >/dev/null 2>&1 || true
        ;;
esac

if [ "$1" = purge ]; then
    rm -rf /var/lib/devnet
fi

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi

exit 0
